# ==============================================================================
# TaskFlow Environment Configuration (.env)
# Academic Project: Task Management System
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# JSON Web Token Secret & Expiration
JWT_SECRET=taskflow_academic_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Supabase PostgreSQL Configuration
# 1. Sign up at https://supabase.com and create a free project.
# 2. Go to Project Settings -> API to copy your Project URL and anon public key.
# 3. Paste the values below:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
